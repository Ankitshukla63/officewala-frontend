{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "officewala-router",
  "main": "workers/router/worker.ts",
  "compatibility_date": "2024-11-01",
  "services": [
    {
      "binding": "APP_A",
      "service": "officewala-app-a"
    },
    {
      "binding": "APP_B",
      "service": "officewala-app-b"
    }
  ],
  "vars": {
    "ROUTER_VERSION": "1.0.0",
    "ENVIRONMENT": "production"
  }
}

